# PlayerOK Auto Commerce — application settings (copy to backend/.env).
# Never commit the real .env. Secrets go only here or into your hosting's secret manager.

# ── Runtime ────────────────────────────────────────────────────────────────
# development | production (production: secure cookies, required secrets checked at start)
APP_ENV=production
# test: purchases and publications are simulated (default). live needs ALLOW_LIVE_OPERATIONS=true
APP_MODE=test
ALLOW_LIVE_OPERATIONS=false
LOG_LEVEL=INFO
LOG_JSON=true
DISPLAY_TIMEZONE=Europe/Moscow

# ── Web panel / API ────────────────────────────────────────────────────────
# Public address of the panel (Vercel or your domain), https:// in production
WEB_BASE_URL=https://panel.example.com
# Number of reverse proxies in front of the API that append X-Forwarded-For:
# Caddy only → 1; Vercel rewrite → Caddy → 2; no proxy → 0
TRUSTED_PROXY_HOPS=2
# 64+ random characters: `python -c "import secrets; print(secrets.token_urlsafe(64))"`
SECRET_KEY=
# Fernet key for supplier keys, digital codes and 2FA secrets: `python -m autocommerce.cli gen-key`
# Rotation: put the new key first, comma, old key; then run `python -m autocommerce.cli rotate-keys`
CREDENTIALS_KEY=
SESSION_HOURS=12
SESSION_IDLE_MINUTES=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ── Storage ────────────────────────────────────────────────────────────────
# docker-compose sets DATABASE_URL and REDIS_URL itself; set them here for systemd/local runs.
# Plain postgres:// URLs (Neon, Supabase, Railway) are accepted too.
DATABASE_URL=postgresql+asyncpg://pac:CHANGE_ME@localhost:5432/pac
# Optional: Redis keeps the bot's dialog state across restarts
REDIS_URL=

# ── Telegram ───────────────────────────────────────────────────────────────
# Token from @BotFather. Revoke and replace it if it was ever shown in a chat or a screenshot.
BOT_TOKEN=
# Bot username without @ (for the panel's «Привязать Telegram» link)
BOT_USERNAME=
# Telegram user IDs with full access and notifications, comma separated (/id in the bot shows yours)
OWNER_TELEGRAM_IDS=
# Seconds a revealed digital code stays in the chat before it is deleted
CODE_REVEAL_TTL_SECONDS=120

# ── Worker ─────────────────────────────────────────────────────────────────
WORKER_POLL_SECONDS=2
WORKER_CONCURRENCY=4

# ── Suppliers (optional; can also be entered in the panel, stored encrypted) ─
VEXBOOST_API_KEY=
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
# true = Reloadly sandbox (no real money). Switch to false only after testing.
RELOADLY_SANDBOX=true
FRAGMENT_MIN_INTERVAL_MINUTES=30

# ── Retention (days) ───────────────────────────────────────────────────────
RETENTION_LOGS_DAYS=180
RETENTION_MESSAGES_DAYS=365
RETENTION_NOTIFICATIONS_DAYS=90
