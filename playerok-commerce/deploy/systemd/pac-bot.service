# Telegram bot (long polling). Only one instance can run: a PostgreSQL advisory
# lock stops a second copy.
[Unit]
Description=PlayerOK Commerce Telegram bot
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=pac
Group=pac
WorkingDirectory=/opt/playerok-commerce/backend
EnvironmentFile=/opt/playerok-commerce/backend/.env
ExecStart=/opt/playerok-commerce/backend/.venv/bin/python -m autocommerce.bot
Restart=always
RestartSec=10
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/playerok-commerce/backend/storage
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
