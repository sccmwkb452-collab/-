# Alternative to docker-compose: the API under systemd.
# Install: see docs/DEPLOY.md («Без Docker»). Paths assume /opt/playerok-commerce and user «pac».
[Unit]
Description=PlayerOK Commerce API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=pac
Group=pac
WorkingDirectory=/opt/playerok-commerce/backend
EnvironmentFile=/opt/playerok-commerce/backend/.env
ExecStart=/opt/playerok-commerce/backend/.venv/bin/uvicorn autocommerce.api.app:app --host 127.0.0.1 --port 8000 --no-server-header --no-proxy-headers
Restart=always
RestartSec=5
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/playerok-commerce/backend/storage
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
