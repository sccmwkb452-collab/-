# Variables for docker-compose.yml (copy to .env next to docker-compose.yml).
# Application settings and secrets live in backend/.env (see backend/.env.example).

# PostgreSQL password: long random string, e.g. `openssl rand -hex 24`
POSTGRES_PASSWORD=

# Public domain of the API (DNS A record → this server). Caddy gets the HTTPS certificate.
API_DOMAIN=api.example.com

# Only for the self-hosted panel (profile "panel"):
# PANEL_DOMAIN=panel.example.com
# CADDYFILE=./deploy/Caddyfile.panel
