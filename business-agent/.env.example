# ── Telegram ─────────────────────────────────────────────────────────────
# Токен бота от @BotFather. В @BotFather → Bot Settings → Business Mode → включить.
BOT_TOKEN=
# Администраторы (Telegram ID через запятую). Только они меняют глобальные инструкции ИИ.
ADMIN_IDS=8790784360
# Кто ещё может пользоваться панелью и подключать свой бизнес-аккаунт. Пусто — только администраторы.
ALLOWED_USER_IDS=

# ── Хранилища ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://agent:agent@db:5432/agent
POSTGRES_PASSWORD=agent
# Redis для состояний панели. Пусто — состояния в памяти процесса.
REDIS_URL=redis://redis:6379/0

# ── ИИ (Claude, Anthropic API) ───────────────────────────────────────────
ANTHROPIC_API_KEY=
# Альтернатива — OpenAI (используется, если ANTHROPIC_API_KEY пуст или AI_PROVIDER=openai)
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max — глубина рассуждений по умолчанию
AI_EFFORT=medium
# Серверный запасной вариант модели, если основная откажется отвечать
AI_SERVER_FALLBACKS=true

# ── Торговый бот: Crypto Pay API (@CryptoBot) ────────────────────────────
# @CryptoBot → Crypto Pay → Create App → API Token. Для тестов — @CryptoTestnetBot и testnet.
CRYPTO_PAY_API_TOKEN=
CRYPTO_PAY_NETWORK=mainnet

# ── HTTP-парсеры ─────────────────────────────────────────────────────────
# Токен для парсера с именем NAME из панели: PARSER_TOKEN_<NAME>
# PARSER_TOKEN_PARSER1=

# ── Прочее ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false
# Пауза перед ответом агента (собирает подряд идущие сообщения), секунд
REPLY_DELAY_SECONDS=4
SCHEDULER_INTERVAL_SECONDS=30
FFMPEG_PATH=ffmpeg
