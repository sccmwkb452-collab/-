# Copy to .env and fill in. Never commit .env.
# test = development/testing, production = live bot with real payments
ENVIRONMENT=production
LOG_LEVEL=INFO

# Token from @BotFather
BOT_TOKEN=
# Your numeric Telegram ID(s), comma-separated (find yours via @userinfobot). Usernames are NOT accepted.
ADMIN_IDS=

# PostgreSQL. In docker-compose the host is "db".
POSTGRES_USER=nft_bot
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=nft_bot
DATABASE_URL=postgresql+asyncpg://nft_bot:change-me-to-a-long-random-password@db:5432/nft_bot

# Encryption key for sensitive data. Generate: python scripts/generate_key.py
# Losing it makes stored Business connections unreadable (owners would reconnect).
ENCRYPTION_KEY=

# TON wallet address that RECEIVES payments (public address only; no seed phrase / private key needed).
TON_RECEIVER_ADDRESS=
TON_API_URL=https://toncenter.com/api/v2
# Optional, raises toncenter rate limits: get it from @tonapibot
TON_API_KEY=

SUBSCRIPTION_PRICE_TON=10
SUBSCRIPTION_DAYS=30
PAYMENT_TTL_MINUTES=30
PAYMENT_POLL_SECONDS=30
EXPIRY_WARNING_HOURS=72
TRANSFER_CONFIRM_TTL_SECONDS=300
RATE_LIMIT_PER_MINUTE=30

# Optional Premium custom emoji IDs (digits). Can also be set with /set_emoji in the bot.
# EMOJI_GIFT=
# EMOJI_SUBSCRIPTION=
