{$DOMAIN} {
	# Only payment notifications, the health check and the beta preview are routed.
	handle /payments/* {
		reverse_proxy bot:8080
	}
	# Beta preview (only answers when BETA_SITE=true and the key matches)
	handle /beta/* {
		reverse_proxy bot:8080
	}
	handle /healthz {
		reverse_proxy bot:8080
	}
	handle {
		respond 404
	}
}
