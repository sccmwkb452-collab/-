# ── Telegram ──────────────────────────────────────────────────────────────
# Token from @BotFather
BOT_TOKEN=
# Telegram IDs of administrators, comma separated (find yours via @userinfobot)
ADMIN_IDS=
# Initial shop name; later change it in the admin panel → Settings
SHOP_NAME=ACCOUNTS MARKET

# development | production  (production forbids the DEMO payment provider and demo data)
ENVIRONMENT=production
LOG_LEVEL=INFO

# ── Database (docker compose builds DATABASE_URL from these) ─────────────
POSTGRES_USER=market
POSTGRES_PASSWORD=change-me
POSTGRES_DB=market
# For running outside Docker:
# DATABASE_URL=postgresql+asyncpg://market:change-me@localhost:5432/market
# REDIS_URL=redis://localhost:6379/0

# ── Payments ──────────────────────────────────────────────────────────────
# demo | cryptopay | yookassa
PAYMENT_PROVIDER=cryptopay
# Must be true to use PAYMENT_PROVIDER=demo (development only)
DEMO_MODE=false
PAYMENT_TTL_MINUTES=60
PAYMENT_POLL_SECONDS=30
MAX_TOPUP_RUB=100000

# Crypto Pay (@CryptoBot → Crypto Pay → Create App)
CRYPTOPAY_TOKEN=
CRYPTOPAY_TESTNET=false
CRYPTOPAY_ACCEPTED_ASSETS=USDT,TON,BTC

# YooKassa (yookassa.ru → Integration → API keys)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Where the buyer returns after paying; defaults to https://t.me/<bot>
YOOKASSA_RETURN_URL=

# ── Webhooks (optional, payments are also checked every PAYMENT_POLL_SECONDS) ──
# Domain pointing to this server; enables HTTPS via Caddy
DOMAIN=
WEBHOOK_PORT=8080

# ── Beta preview site (development only, refused with ENVIRONMENT=production) ──
# Web chat at http://<host>:8080/beta/<BETA_KEY>/ that runs the real bot logic
# against an in-process Telegram imitation. Not linked from the bot anywhere.
# Without BOT_TOKEN the process runs the beta site only.
BETA_SITE=false
# 16+ letters/digits; empty = a random key printed to the log on every start
BETA_KEY=

# ── Backups ───────────────────────────────────────────────────────────────
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
