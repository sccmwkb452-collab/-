# ─── Telegram ────────────────────────────────────────────────────────────────
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
BOT_ADMIN_IDS=123456789,987654321
# Webhook (оставь пустым для long-polling)
WEBHOOK_HOST=
WEBHOOK_PATH=/webhook
WEBHOOK_PORT=8443

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=nft_gifts
POSTGRES_USER=nft_user
POSTGRES_PASSWORD=change_me_in_production

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
DEBUG_SQL=false              # Логировать SQL-запросы

# ─── Payments ────────────────────────────────────────────────────────────────
# Telegram Stars (встроенные платежи Telegram)
PAYMENTS_PROVIDER_TOKEN=
# CryptoBot (https://t.me/CryptoBot)
CRYPTOBOT_API_TOKEN=
CRYPTOBOT_API_URL=https://pay.crypt.bot/api

# ─── TON Blockchain ───────────────────────────────────────────────────────────
# Адрес кошелька, на который пользователи переводят TON
TON_RECIPIENT_ADDRESS=
# API-ключ TonCenter (https://toncenter.com) — опционально, но рекомендуется
TONCENTER_API_KEY=
# mainnet | testnet
TON_NETWORK=mainnet
# Стоимость подписки в TON
SUB_PRICE_TON=10.0
# Окно ожидания оплаты в минутах
PAYMENT_WINDOW_MINUTES=60

# ─── Subscriptions ───────────────────────────────────────────────────────────
SUB_BASIC_PRICE_STARS=100
SUB_PREMIUM_PRICE_STARS=300
SUB_BASIC_DURATION_DAYS=30
SUB_PREMIUM_DURATION_DAYS=30

# ─── MTProto (Telegram Account Connection) ───────────────────────────────────
# Получи на https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Ключ шифрования сессий. Сгенерируй:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ACCOUNT_ENCRYPTION_KEY=

# ─── Shop ────────────────────────────────────────────────────────────────────
# Цена по умолчанию для товаров магазина (TON). Можно изменить через /set shop_price_ton
# Товар появляется в каталоге ТОЛЬКО после /shop verify <id> <примечание>
SHOP_PRICE_TON=5.0

# ─── Support ─────────────────────────────────────────────────────────────────
SUPPORT_USERNAME=support_bot

# ─── Premium Custom Emoji IDs ─────────────────────────────────────────────────
# Оставь пустым — бот использует обычные emoji.
# Получи реальные ID через getCustomEmojiStickers API или @stickers бот.
# Пример реального ID: 5368324170671202286
# Редактируй напрямую в config/emoji.py — поле custom_id каждого EMOJI-элемента.
