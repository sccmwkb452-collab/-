# Local development: cp backend/dev.env.example backend/.env
APP_ENV=development
DEV_AUTH_ENABLED=true
APP_MODE=demo
DATABASE_URL=postgresql+asyncpg://stars:stars@localhost:5432/stars
REDIS_URL=redis://localhost:6379/0
# Any syntactically valid token works for the Mini App/admin in a browser;
# a real token is needed only to run the bot.
BOT_TOKEN=123456789:AAdevTOKENdevTOKENdevTOKENdevTOKEN000
BOT_USERNAME=your_bot
PUBLIC_BASE_URL=http://localhost:5173
SECRET_KEY=dev-secret-key-dev-secret-key-0123456789
ADMIN_TELEGRAM_IDS=100001
PAYMENT_PROVIDERS=demo
DELIVERY_PROVIDER=demo
LOG_JSON=false
