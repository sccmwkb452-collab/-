# ============================================================================
# Pulsar — Telegram Stars shop. Copy to .env and fill in. Never commit .env.
# deploy/scripts/install.sh generates passwords and secrets automatically.
# ============================================================================

# --- Domain & runtime --------------------------------------------------------
# Public domain pointing to this server (A record). HTTPS is issued for it.
DOMAIN=shop.example.com
LETSENCRYPT_EMAIL=admin@example.com
# demo | production. The owner can switch it in the admin panel, but only
# if ALLOW_PRODUCTION=true AND real payment + delivery providers are configured.
APP_MODE=demo
ALLOW_PRODUCTION=false
LOG_LEVEL=INFO
DISPLAY_TIMEZONE=Europe/Moscow
# 32+ random characters (openssl rand -hex 32). Signs CSRF tokens and DEMO events.
SECRET_KEY=

# --- PostgreSQL (alphanumeric password: it is embedded in a URL) -------------
POSTGRES_DB=starshop
POSTGRES_USER=starshop
POSTGRES_PASSWORD=

# --- Telegram -----------------------------------------------------------------
# From @BotFather. Kept server-side only.
BOT_TOKEN=
# Without @, e.g. pulsar_stars_bot
BOT_USERNAME=
# Optional: short name of the Mini App created with /newapp (enables t.me/<bot>/<app> links)
WEBAPP_SHORT_NAME=
# polling (simplest) | webhook (updates via https://DOMAIN/tg/webhook)
BOT_MODE=polling
# Required for BOT_MODE=webhook: random string, sent by Telegram in a header.
BOT_WEBHOOK_SECRET=
# Comma-separated Telegram IDs that are always admin owners.
ADMIN_TELEGRAM_IDS=

# --- Brand defaults (editable later in Admin → Content) -----------------------
BRAND_NAME=Pulsar
BRAND_TAGLINE=Telegram Stars без лишних шагов
SHOP_CURRENCY=RUB
SUPPORT_TELEGRAM=
SUPPORT_EMAIL=

# --- Orders -------------------------------------------------------------------
ORDER_PAYMENT_TTL_MINUTES=30
MAX_OPEN_ORDERS_PER_USER=5

# --- Payments -------------------------------------------------------------------
# Enabled providers: demo (DEMO mode only), cryptopay
PAYMENT_PROVIDERS=demo
# Crypto Pay (@CryptoBot → Crypto Pay → Create App). Testnet: @CryptoTestnetBot.
CRYPTOPAY_API_TOKEN=
CRYPTOPAY_NETWORK=testnet
CRYPTOPAY_ACCEPTED_ASSETS=USDT,TON,BTC
CRYPTOPAY_VERIFY_VIA_API=true

# --- Delivery of Stars --------------------------------------------------------
# demo          — DEMO only, nothing is sent
# manual        — operator buys on fragment.com and confirms in the admin panel
# http_supplier — your supplier bridge implementing docs/DELIVERY.md
DELIVERY_PROVIDER=demo
DELIVERY_MIN_STARS=50
DELIVERY_MAX_STARS=1000000
DELIVERY_MAX_ATTEMPTS=5
SUPPLIER_API_URL=
SUPPLIER_API_KEY=
SUPPLIER_API_SECRET=
SUPPLIER_TIMEOUT_SECONDS=20

# --- Serverless (Vercel) --------------------------------------------------------
# Set by starshop/serverless.py on Vercel, see docs/VERCEL.md. Keep them off on a VPS.
# PUBLIC_DEMO=false
# INLINE_WORKER=false
# AUTO_MIGRATE=false
# DATABASE_POOL_SIZE=10

# --- Limits ---------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_IP_PER_MINUTE=240
ADMIN_SESSION_HOURS=12
