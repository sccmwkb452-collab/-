# --- База данных (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/forma?schema=public"

# --- Авторизация ---
# Случайная строка минимум 32 символа: openssl rand -base64 48
AUTH_SECRET=""

# --- Публичный адрес сайта (canonical, sitemap, OpenGraph) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Уведомления в Telegram (оставьте пустым, чтобы отключить) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Email-уведомления через SMTP (оставьте SMTP_HOST пустым, чтобы отключить) ---
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
NOTIFY_EMAIL_TO=""

# --- Хранилище файлов: local | s3 ---
STORAGE_DRIVER="local"
# Папка для локального хранилища (относительно корня проекта)
STORAGE_LOCAL_DIR="storage/uploads"
# S3-совместимое хранилище (Yandex Object Storage, Selectel, MinIO, AWS)
S3_ENDPOINT=""
S3_REGION="ru-central1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Публичный URL бакета, например https://storage.yandexcloud.net/my-bucket
S3_PUBLIC_URL=""

# --- Аналитика (оставьте пустым, чтобы отключить) ---
NEXT_PUBLIC_YANDEX_METRIKA_ID=""
NEXT_PUBLIC_GA_ID=""

# --- Администратор по умолчанию для seed ---
SEED_ADMIN_EMAIL="admin@forma-house.ru"
SEED_ADMIN_PASSWORD="ChangeMe-2026!"
